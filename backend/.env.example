# LOCAL DEVELOPMENT ONLY. Copy to .env (git-ignored). Loaded only when APP_ENV=development.
# APP_ENV itself must be set in the real environment ($env:APP_ENV = "development"), not here.
#
# Production never uses a .env file: secrets come from the host (environment variables or
# *_FILE secret files protected by file ACLs). See docs/DEPLOYMENT.md.

# Optional in development: a random ephemeral key is generated per start if unset.
# SECRET_KEY=

# Optional in development: defaults to SQLite files under backend/instance/.
# USERS_DATABASE_URL=sqlite:///instance/users.sqlite3
# PLANS_DATABASE_URL=sqlite:///instance/plans.sqlite3

LOG_LEVEL=DEBUG
LOG_FORMAT=text
